<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac 用户级 LaunchAgent：非 root，tailscaled 用 --tun=userspace-networking -->
<!-- 仍支持 exit node：darwin 上子网/出口转发走 netstack 用户态并自带 NAT -->
{% if ts_forward_proxy is defined and ts_forward_proxy | length > 0 -%}
<!-- 透传本地代理（如 Clash Verge）给 tailscale exit node 转发流量（TS_FORWARD_PROXY）-->
{% endif -%}
{% if ts_control_proxy is defined and ts_control_proxy | length > 0 -%}
<!-- tailscaled 自身访问控制面（controlplane.tailscale.com）走的代理（HTTP_PROXY/HTTPS_PROXY）-->
<!-- TS_FORWARD_PROXY 只对 exit node 转发流量生效，不影响 tailscaled 连控制面 -->
{% endif -%}
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tailscale.tailscaled</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>mkdir -p "{{ ts_state_dir | dirname }}" &amp;&amp; exec {{ ts_install_dir }}/tailscaled --tun=userspace-networking --statedir={{ ts_state_dir }} --socket={{ ts_socket }} --port={{ ts_port }}</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TS_FORWARD_PROXY</key>
		<string>{{ ts_forward_proxy | default('') }}</string>
		{% if ts_control_proxy is defined and ts_control_proxy | length > 0 %}
		<key>HTTP_PROXY</key>
		<string>{{ ts_control_proxy }}</string>
		<key>HTTPS_PROXY</key>
		<string>{{ ts_control_proxy }}</string>
		{% endif %}
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{ ts_state_dir | dirname }}/tailscaled.out.log</string>
	<key>StandardErrorPath</key>
	<string>{{ ts_state_dir | dirname }}/tailscaled.err.log</string>
</dict>
</plist>
