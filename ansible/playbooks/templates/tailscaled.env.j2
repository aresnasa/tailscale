# Tailscale 节点配置 —— tailscaled 与 tailscale CLI 共享
# Tailscale 节点配置 —— tailscaled 与 CLI 共享
# 连通关键: 两个进程必须使用同一个 TS_SOCKET（CLI 也要带 --socket）
TS_STATE_DIR={{ ts_state_dir }}
TS_SOCKET={{ ts_socket }}
TS_PORT={{ ts_port }}
# 透传本地代理（如 Clash Verge）给 tailscale exit node 转发流量
# 示例: socks5://127.0.0.1:7891 或 http://127.0.0.1:7890
{% if ts_forward_proxy is defined and ts_forward_proxy | length > 0 %}TS_FORWARD_PROXY={{ ts_forward_proxy }}
{% endif %}
# 追加给 tailscaled 的额外参数
FLAGS=
