# Tailscale 节点配置 —— tailscaled 与 tailscale CLI 共享
# 连通关键: 两个进程必须使用同一个 TS_SOCKET（CLI 也要带 --socket）
TS_STATE_DIR={{ ts_state_dir }}
TS_SOCKET={{ ts_socket }}
TS_PORT={{ ts_port }}
# tailscaled 自身访问控制面（controlplane.tailscale.com）走的代理
# 仅 Mac 需要（Mac 在 GFW 环境下直连控制面被墙，需走 Clash）
# exit node 的转发流量请用 Clash TUN/增强模式在系统层接管，无需此处设置
{% if ts_platform == 'darwin' and ts_control_proxy is defined and ts_control_proxy | length > 0 %}HTTP_PROXY={{ ts_control_proxy }}
HTTPS_PROXY={{ ts_control_proxy }}
{% endif %}
# 追加给 tailscaled 的额外参数
FLAGS=
