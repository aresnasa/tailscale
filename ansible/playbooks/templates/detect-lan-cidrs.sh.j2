#!/bin/sh
# detect-lan-cidrs.sh — 输出需要 ignore 的 RFC1918 私有网段列表
#
# 策略：直接输出三大 RFC1918 私有网段，覆盖所有可能的内网场景：
#   - 物理网卡 LAN（10.x、172.16-31.x、192.168.x）
#   - Docker bridge（默认 172.17.0.0/16）
#   - Docker user-defined network（172.18-31.x）
#   - K8s pod/service（10.x、172.x）
#   - Cilium/Flannel/Calico 等 CNI（10.x、192.168.x）
#
# 这样不管容器/集群用了哪个内网段，都不会被 exit node 隧道捕获，
# 避免内网不可达问题。公网流量仍正常走 exit node。
#
# 如果节点有公网 IP 落在这些段内（极少见），可在 host_vars 手动覆盖。
#
# 输出: 一行一个 CIDR，供 Ansible 读取
#
# 用法: detect-lan-cidrs.sh

# 如果有自定义配置文件 /etc/tailscale/custom-lan-routes.conf，优先用它
# （管理员可在此文件中精确指定要忽略的网段，覆盖默认的三大段）
if [ -f /etc/tailscale/custom-lan-routes.conf ]; then
    grep -v '^[[:space:]]*#' /etc/tailscale/custom-lan-routes.conf \
        | grep -v '^[[:space:]]*$' \
        | sort -u
    exit 0
fi

# 默认：输出 RFC1918 三大私有网段
echo "10.0.0.0/8"
echo "172.16.0.0/12"
echo "192.168.0.0/16"
